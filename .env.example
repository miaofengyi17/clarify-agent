# ===== 上游大模型配置 =====
# 真正处理你请求的大模型地址
UPSTREAM_BASE_URL=https://api.openai.com/v1
# 你的大模型 API Key（必填）
UPSTREAM_API_KEY=sk-your-real-key-here

# ===== 判断模型 =====
# 用来检测用户输入是否模糊的小模型，越便宜越好
JUDGE_MODEL=gpt-4o-mini

# ===== 会话存储 =====
# memory: 存内存，重启丢失；redis: 存 Redis，重启保留
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379

# ===== 功能开关 =====
ENABLE_CLARIFY=true
ENABLE_CONTEXT_PANEL=true

# ===== 服务器 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ===== 限制 =====
MAX_CLARIFY_QUESTIONS=3
MAX_SESSION_TURNS=20